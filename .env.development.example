# Copy to .env.development, replace this value, and never commit the result.
# Generate one with: openssl rand -hex 32
PI_API_KEY=replace-with-a-random-token-of-at-least-32-bytes
PUBLIC_BASE_URL=http://localhost:3012
# Optional only after receiving a tldraw production license:
# TLDRAW_LICENSE_KEY_FILE=/absolute/path/to/tldraw-license-key
